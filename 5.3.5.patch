+
+    def test_partial_delivery_state_transition(self):
+        self.order.action_confirm()
+        self.assertEqual(self.order.delivery_status, "pending")
+        first_line = self.order.order_line[0]
+        first_line.qty_delivered = first_line.product_uom_qty / 2
+        self.assertEqual(self.order.delivery_status, "partial")
+        for line in self.order.order_line:
+            line.qty_delivered = line.product_uom_qty
+        self.assertEqual(self.order.delivery_status, "full")
+
+    def test_partial_delivery_with_multiple_lines(self):
+        self.order.action_confirm()
+        line_count = len(self.order.order_line)
+        self.assertEqual(self.order.delivery_status, "pending")
+        first_line = self.order.order_line[0]
+        first_line.qty_delivered = first_line.product_uom_qty
+        self.assertEqual(self.order.delivery_status, "partial")
+        for line in self.order.order_line - first_line:
+            line.qty_delivered = line.product_uom_qty
+        self.assertEqual(self.order.delivery_status, "full")
+
+    def test_action_deliver_method(self):
+        self.order.action_confirm()
+        self.assertEqual(self.order.delivery_status, "pending")
+        self.order.action_deliver()
+        self.assertEqual(self.order.delivery_status, "full")
+
+    def test_action_deliver_not_confirmed(self):
+        self.order.action_deliver()
+        self.assertEqual(self.order.delivery_status, "pending")
+
+    def test_force_and_unforce_delivery_state(self):
+        self.order.action_confirm()
+        self.order.order_line[0].qty_delivered = 2
+        self.assertEqual(self.order.delivery_status, "partial")
+        self.order.action_force_delivery_state()
+        self.assertEqual(self.order.delivery_status, "full")
+        self.assertTrue(self.order.force_delivery_state)
+        self.order.action_unforce_delivery_state()
+        self.assertEqual(self.order.delivery_status, "partial")
+        self.assertFalse(self.order.force_delivery_state)
+
+    def test_cancel_order_resets_delivery_status(self):
+        self.order.action_confirm()
+        self.order.order_line[0].qty_delivered = 2
+        self.assertEqual(self.order.delivery_status, "partial")
+        self.order.action_cancel()
+        self.assertEqual(self.order.delivery_status, "pending")
+
+    def test_draft_order_delivery_status(self):
+        self.assertEqual(self.order.state, "draft")
+        self.assertEqual(self.order.delivery_status, "pending")
+
+    def test_sent_order_delivery_status(self):
+        self.order.action_quotation_sent()
+        self.assertEqual(self.order.delivery_status, "pending")
+
+    def test_cross_module_sale_stock_interaction(self):
+        self.order.action_confirm()
+        self.assertTrue(hasattr(self.order, "picking_ids"))
+        self.assertEqual(self.order.delivery_status, "pending")
+        first_line = self.order.order_line[0]
+        first_line.qty_delivered = first_line.product_uom_qty / 2
+        self.assertEqual(self.order.delivery_status, "partial")
+        for line in self.order.order_line:
+            line.qty_delivered = line.product_uom_qty
+        self.assertEqual(self.order.delivery_status, "full")
+
+    def test_partial_delivery_skip_delivery_costs(self):
+        self._add_delivery_cost_line()
+        with self._mock_delivery():
+            self.order.action_confirm()
+            self.assertEqual(self.order.delivery_status, "pending")
+            product_lines = self.order.order_line.filtered(
+                lambda l: not l._is_delivery()
+            )
+            first_product_line = product_lines[0]
+            first_product_line.qty_delivered = first_product_line.product_uom_qty / 2
+            self.assertEqual(self.order.delivery_status, "partial")
+            for line in product_lines:
+                line.qty_delivered = line.product_uom_qty
+            self.assertEqual(self.order.delivery_status, "full")
+
+    def test_partial_to_full_with_force_flag(self):
+        self.order.action_confirm()
+        self.order.order_line[0].qty_delivered = 1
+        self.assertEqual(self.order.delivery_status, "partial")
