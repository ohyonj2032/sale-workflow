<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale_advanced_workflow.view_order_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_pending_review"
                    type="object"
                    string="Send to Pending Review"
                    class="btn-primary"
                    invisible="not show_pending_review_button"
                />
            </header>
        </field>
    </record>
</odoo>