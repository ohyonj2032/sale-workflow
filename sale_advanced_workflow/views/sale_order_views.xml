<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.advanced.workflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][1]" position="after">
                <button
                    name="action_pending_review"
                    type="object"
                    string="Submit for Review"
                    class="btn-primary"
                    invisible="not can_pending_review"
                    data-hotkey="shift+r"
                />
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="can_pending_review" invisible="1" />
                <field name="review_threshold" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
