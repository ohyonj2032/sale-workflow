#. module: sale_credit_hold
#: model:ir.model,name:sale_credit_hold.model_res_partner
msgid "Contact"
msgstr "联系人"

#. module: sale_credit_hold
#: model:ir.model.fields,field_description:sale_credit_hold.field_res_partner__credit_limit
msgid "Credit Limit"
msgstr "信用额度"

#. module: sale_credit_hold
#: model:ir.model.fields,help:sale_credit_hold.field_res_partner__credit_limit
msgid ""
"Maximum credit allowed for this partner. "
"When exceeded, new sale orders will be put on credit hold."
msgstr ""
"该客户允许的最大信用额度。"
"超出后，新的销售订单将被信用冻结。"

#. module: sale_credit_hold
#: model:res.groups,name:sale_credit_hold.group_credit_manager
msgid "Credit Manager"
msgstr "信用管理员"

#. module: sale_credit_hold
#: model:res.groups,comment:sale_credit_hold.group_credit_manager
msgid ""
"The user will be able to release credit-hold sale orders."
msgstr "该用户将能够解除信用冻结的销售订单。"

#. module: sale_credit_hold
#: model:ir.model.fields,field_description:sale_credit_hold.field_sale_order__credit_hold
msgid "Credit Hold"
msgstr "信用冻结"

#. module: sale_credit_hold
#: model:ir.model.fields,help:sale_credit_hold.field_sale_order__credit_hold
msgid "Technical field indicating the order is on credit hold"
msgstr "技术字段，指示订单处于信用冻结状态"

#. module: sale_credit_hold
#: model:ir.model.fields,field_description:sale_credit_hold.field_sale_order__credit_hold_released_date
msgid "Credit Hold Released Date"
msgstr "信用冻结解除日期"

#. module: sale_credit_hold
#: model:ir.model.fields,field_description:sale_credit_hold.field_sale_order__credit_hold_released_by
msgid "Credit Hold Released By"
msgstr "信用冻结解除人"

#. module: sale_credit_hold
#: model_terms:ir.ui.view,arch_db:sale_credit_hold.sale_order_form_credit_hold
msgid "Credit Hold Information"
msgstr "信用冻结信息"

#. module: sale_credit_hold
#: model_terms:ir.ui.view,arch_db:sale_credit_hold.sale_order_search_credit_hold
msgid "Credit Hold"
msgstr "信用冻结"

#. module: sale_credit_hold
#: model_terms:ir.ui.view,arch_db:sale_credit_hold.sale_order_form_credit_hold
msgid "Release Credit Hold"
msgstr "解除信用冻结"

#. module: sale_credit_hold
#: model_terms:ir.ui.view,arch_db:sale_credit_hold.sale_order_form_credit_hold
msgid ""
"Are you sure you want to release the credit hold? "
"This will trigger procurement and delivery processes."
msgstr ""
"确定要解除信用冻结吗？"
"这将触发采购和发货流程。"

#. module: sale_credit_hold
#: model:ir.model,name:sale_credit_hold.model_sale_order
msgid "Sales Order"
msgstr "销售订单"

#. module: sale_credit_hold
#. odoo-python
#: code:addons/sale_credit_hold/models/sale_order.py:0
msgid "Only Credit Managers can release credit-hold orders."
msgstr "只有信用管理员才能解除信用冻结订单。"

#. module: sale_credit_hold
#. odoo-python
#: code:addons/sale_credit_hold/models/sale_order.py:0
msgid ""
"Credit hold released by %(user)s. "
"Procurement and delivery processes have been triggered."
msgstr ""
"由 %(user)s 解除信用冻结。"
"采购和发货流程已触发。"

#. module: sale_credit_hold
#. odoo-python
#: code:addons/sale_credit_hold/models/sale_order.py:0
msgid ""
"Cannot change state from credit_hold to sale "
"for order '%(name)s'. Only Credit Managers "
"can release credit-hold orders via the "
"'Release Credit Hold' action."
msgstr ""
"无法将订单 '%(name)s' 的状态从信用冻结改为销售。"
"只有信用管理员才能通过"解除信用冻结"操作来释放信用冻结订单。"

#. module: sale_credit_hold
#: model:ir.model.fields.selection,name:sale_credit_hold.selection__sale_order__state__credit_hold
msgid "Credit Hold"
msgstr "信用冻结"