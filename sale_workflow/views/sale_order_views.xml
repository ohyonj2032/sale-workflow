<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_workflow" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.workflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_deliver" type="object" string="Deliver" class="btn-primary" attrs="{'invisible': [('state', 'not in', ['sale', 'partial'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>
